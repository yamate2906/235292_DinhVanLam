# Cổng chạy Backend API
PORT=5000

# Chuỗi kết nối MongoDB Atlas (Database: 235292_DinhVanLam)
# Thay thế username, password và cluster theo tài khoản MongoDB Atlas của bạn
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/235292_DinhVanLam?retryWrites=true&w=majority

# URL Frontend được phép gọi CORS (nếu chạy trực tiếp không qua proxy)
CLIENT_URL=http://localhost:5173
